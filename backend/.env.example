# DonorNexa Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your production credentials

# Database Connection (PostgreSQL)
# Format for asyncpg (used by FastAPI async endpoints):
# postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/donornexa

# Format for psycopg (used for synchronous migrations & tasks):
SYNC_DATABASE_URL=postgresql+psycopg://postgres:your_db_password@localhost:5432/donornexa

# Security & JWT Tokens
# Generate a secure random 64-character secret with: openssl rand -hex 32
SECRET_KEY=generate_a_secure_random_jwt_secret_key_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads Storage
UPLOAD_DIR=uploads

# Environment Mode: 'development' or 'production'
# In 'production', cookies automatically use secure=True and samesite="none" for cross-domain auth
ENVIRONMENT=development

# Allowed CORS Origins (Comma-separated string or JSON array)
# In production, add your deployed frontend domain (e.g. https://donornexa.vercel.app)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Regional Timezone
TIMEZONE=Asia/Karachi
