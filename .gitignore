# ==========================================
# DonorNexa .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit to Git)
.env
.env.*
!.env.example
*.env

# Python / Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# User uploads & runtime generated files
uploads/
backend/uploads/
*.pdf
!backend/tests/*.pdf
*.jpg
*.jpeg
*.png
!frontend/src/assets/*
!frontend/public/*

# Databases
*.sqlite
*.sqlite3
*.db

# Operating System & IDE artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
